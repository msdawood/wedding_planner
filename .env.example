# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
ANTHROPIC_API_KEY=
MODEL=
TAVILY_API_KEY=

# FastAPI Web App Configuration
WEB_API_HOST_PORT=8000
WEB_API_CONTAINER_PORT=8000

# Redis Configuration
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379

# Postgres Configuration
POSTGRES_DB=your_postgres_db
POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=

# LiteLLM Configuration
LITELLM_HOST_PORT=4000
LITELLM_CONTAINER_PORT=4000

# E2B Sandbox Configuration
E2B_API_KEY=your_e2b_api_key

# Langfuse Configuration
LANGFUSE_PORT=3000
LANGFUSE_POSTGRES_HOST_PORT=5433
LANGFUSE_POSTGRES_CONTAINER_PORT=5432
LANGFUSE_POSTGRES_USER=your_langfuse_postgres_user
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=your_langfuse_postgres_db
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

NEXTAUTH_SECRET=your_nextauth_secret

# LiteLLM gateway (budget-capped virtual key used by the Celery worker)
LITELLM_MASTER_KEY=sk-... # admin key
LITELLM_WORKER_KEY=sk-... # virtual key the Celery worker uses (created automatically)
LITELLM_MAX_BUDGET=10
LITELLM_BUDGET_DURATION=30d
LITELLM_TPM_LIMIT=100000
LITELLM_RPM_LIMIT=500
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=
LITELLM_POSTGRES_DB=litellm

# API gateway auth
JWT_SECRET=                # >= 32 chars
JWT_EXPIRES_MIN=60
API_USERNAME=admin
API_PASSWORD=
RUNS_PER_MINUTE=10

# Langfuse v3 stack
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=             # exactly 64 hex chars
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=